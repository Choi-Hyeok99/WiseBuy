# 이 파일을 .env로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# .env는 .gitignore에 걸려 있어 커밋되지 않는다. 실제 값은 각자 로컬에서만 관리한다.
# 값의 흐름: .env  ->  docker-compose.yml의 environment: (${...}로 참조)  ->  각 서비스 application.yml
# 그래서 여기 키 이름은 docker-compose.yml이 참조하는 이름과 정확히 같아야 한다.
#
# 참고로 REDIS_HOST / EUREKA_URL / KAFKA_BOOTSTRAP_SERVERS는 여기 없다. 비밀값이 아니라
# 도커 네트워크 안에서 고정된 주소(redis, eureka-server, kafka:29092)라 docker-compose.yml에
# 직접 박아뒀고, 도커 없이 로컬 실행할 땐 application.yml의 기본값(localhost)이 쓰인다.


# ---- MySQL ----
# 로컬 개발용이라 값 자체는 아무거나 상관없다. 단, 아래 규칙만 지키면 된다.
#   - MYSQL_USER == SPRING_DATASOURCE_USERNAME  (앱이 붙는 계정)
#   - MYSQL_PASSWORD == SPRING_DATASOURCE_PASSWORD
# MYSQL_DATABASE는 컨테이너가 처음 뜰 때 만드는 스키마 하나뿐이고, 서비스별 스키마
# (user_schema 등)는 아래 URL의 createDatabaseIfNotExist=true로 접속 시점에 생성된다.
MYSQL_ROOT_PASSWORD=root-password
MYSQL_DATABASE=microservices_db
MYSQL_USER=app
MYSQL_PASSWORD=app-password

# ---- 서비스별 DB 접속 URL ----
# 5개 서비스가 application.yml에서는 다 같은 ${DB_URL}을 쓰지만 붙어야 할 스키마가 다르다.
# 여기서 서비스별로 나눠두고, docker-compose.yml이 각 컨테이너에 DB_URL이라는 이름으로 골라 넣는다.
# 호스트가 localhost가 아니라 microservices_db인 건 도커 네트워크 안의 MySQL 컨테이너 이름이라서다.
SPRING_DATASOURCE_URL_USER=jdbc:mysql://microservices_db:3306/user_schema?createDatabaseIfNotExist=true
SPRING_DATASOURCE_URL_PRODUCT=jdbc:mysql://microservices_db:3306/product_schema?createDatabaseIfNotExist=true
SPRING_DATASOURCE_URL_WISHLIST=jdbc:mysql://microservices_db:3306/wishlist_schema?createDatabaseIfNotExist=true
SPRING_DATASOURCE_URL_ORDER=jdbc:mysql://microservices_db:3306/order_schema?createDatabaseIfNotExist=true
SPRING_DATASOURCE_URL_PAYMENT=jdbc:mysql://microservices_db:3306/payment_schema?createDatabaseIfNotExist=true

SPRING_DATASOURCE_USERNAME=app
SPRING_DATASOURCE_PASSWORD=app-password


# ---- JWT ----
# user가 토큰을 발급하고 gateway/common이 검증한다. 전 서비스가 같은 값을 써야 한다.
# 새로 만들 때:  openssl rand -hex 32
JWT_SECRET=여기에-openssl-rand-hex-32-결과값을-넣는다


# ---- 이메일 (user 서비스, 회원가입 인증메일 발송용 / 네이버 SMTP) ----
# 인증메일 기능을 실제로 테스트할 게 아니면 대충 채워도 앱은 뜬다 (메일 발송 시점에만 실패).
# 쓸 거라면: 네이버 메일 > 환경설정 > POP3/IMAP에서 IMAP 사용으로 켜고,
# 2단계 인증을 쓰는 계정이면 '애플리케이션 비밀번호'를 발급받아 NAVER_MAIL_PASSWORD에 넣는다.
# NAVER_MAIL_ID는 전체 주소가 아니라 @ 앞부분만 (예: hong@naver.com -> hong).
NAVER_MAIL_ID=your-naver-id
NAVER_MAIL_PASSWORD=your-naver-app-password
